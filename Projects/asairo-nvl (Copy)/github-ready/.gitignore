!/docs/TESTING.md
!/tools/
/tools/*
!/tools/common.py
!/tools/mpk.py
!/tools/panel.py
!/tools/resource_recipe.py
!/tools/prepare_payload.py
!/tools/export_source.py
!/hook/
/hook/*
!/hook/nvl_guard.c
!/hook/build.sh
!/hook/generate_forwarders.py
!/hook/winmm-exports.json
!/patch-files/
/patch-files/*
!/patch-files/manifest.json
!/patch-files/winmm.dll
